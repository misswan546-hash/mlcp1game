      <div id="gift3"></div>
    </div>
    <div id="reveal3"><div class="box"><div class="big" id="rv-e"></div><div class="nm" id="rv-n"></div></div></div>
  </div>

  <div id="sc4" class="scene">
    <div class="tiles"></div>
    <div id="tray4"><div class="lbl">焗好嘅曲奇</div><div id="cookie4"></div></div>
    <div id="box4"><div class="lbl">曲奇盒</div></div>
