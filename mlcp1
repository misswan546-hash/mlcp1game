<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>滑鼠小教室 · 港澳信義會小學</title>
<style>
:root{
  --purple:#6B4C93; --purple-d:#4E3570; --sun:#FFD54A; --sun-d:#E0A91C;
  --sky:#BFE7F7; --sky-d:#7CC7E8; --coral:#FF7B6B; --coral-d:#D9564A;
  --leaf:#6FBF73; --leaf-d:#3E9A4E; --cream:#FFFBF0; --ink:#2F3A45;
}
*{box-sizing:border-box;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;font-family:"PingFang HK","Microsoft JhengHei","Noto Sans HK","Heiti TC",system-ui,sans-serif;font-weight:700;color:var(--ink);background:var(--sky)}
img{-webkit-user-drag:none;user-drag:none;pointer-events:none}
input{-webkit-user-select:text;user-select:text;font:inherit}
.screen{position:absolute;inset:0;display:none}
.screen.on{display:block}

/* ---------- shared UI ---------- */
.card{background:var(--cream);border:5px solid #fff;border-radius:34px;box-shadow:0 10px 0 rgba(47,58,69,.10),0 18px 36px rgba(47,58,69,.16)}
.btn{font:inherit;font-size:clamp(18px,3vh,28px);padding:.55em 1.6em;border:none;border-radius:60px;color:#fff;background:var(--coral);box-shadow:0 7px 0 var(--coral-d);cursor:pointer;transition:transform .08s,box-shadow .08s}
.btn:active{transform:translateY(5px);box-shadow:0 2px 0 var(--coral-d)}
.btn.purple{background:var(--purple);box-shadow:0 7px 0 var(--purple-d)}
.btn.purple:active{box-shadow:0 2px 0 var(--purple-d)}
.btn.green{background:var(--leaf-d);box-shadow:0 7px 0 #2C7339}
.btn.green:active{box-shadow:0 2px 0 #2C7339}
.btn:disabled{background:#C9CFD4;box-shadow:0 7px 0 #A8AFB5;cursor:not-allowed;color:#EEF1F3}
.btn.small{font-size:clamp(14px,2.2vh,20px);padding:.4em 1.1em;box-shadow:0 5px 0 var(--coral-d)}
.float{animation:bob 3s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

#hint{position:fixed;top:84px;left:50%;transform:translate(-50%,-10px);opacity:0;z-index:200;padding:.5em 1.4em;border-radius:40px;font-size:clamp(16px,2.8vh,26px);color:#fff;pointer-events:none;transition:all .2s;box-shadow:0 6px 16px rgba(0,0,0,.2);white-space:nowrap}
#hint.show{opacity:1;transform:translate(-50%,0)}
#hint.ok{background:var(--leaf-d)} #hint.no{background:var(--coral-d)}

#ctx{position:fixed;z-index:150;display:none;background:#fff;border:4px solid var(--purple);border-radius:18px;padding:6px;box-shadow:0 10px 24px rgba(0,0,0,.28);min-width:170px}
#ctx.on{display:block}
#ctx button{display:block;width:100%;text-align:left;font:inherit;font-size:clamp(17px,2.8vh,24px);padding:.45em .9em;border:none;background:none;border-radius:12px;cursor:pointer;color:var(--ink)}
#ctx button:hover{background:var(--sun)}

/* ---------- home ---------- */
#s-home{background:linear-gradient(180deg,#BFE7F7 0%,#DDF3FB 60%,#CFEFC6 60%,#A9DE9E 100%)}
.home-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:3vw;padding:2vh 3vw;overflow:auto}
.hero{position:relative;flex:1.15;max-width:760px;height:min(92vh,720px);display:flex;flex-direction:column;align-items:center;justify-content:center}
.hero h1{margin:0;font-size:clamp(44px,9vh,92px);color:var(--purple);letter-spacing:.08em;text-shadow:0 5px 0 #fff,0 0 0 #fff,3px 3px 0 #fff,-3px 3px 0 #fff,0 10px 18px rgba(78,53,112,.25)}
.hero .school{margin:.4vh 0 2vh;font-size:clamp(16px,2.8vh,26px);background:var(--sun);color:var(--ink);padding:.25em 1.2em;border-radius:40px;box-shadow:0 5px 0 var(--sun-d)}
.hero .bld{height:clamp(120px,27vh,260px);filter:drop-shadow(0 8px 6px rgba(0,0,0,.18))}
.hero .kids{display:flex;align-items:flex-end;gap:1vw;margin-top:1vh}
.hero .kids img{height:clamp(110px,24vh,230px)}
.hero .jump{position:absolute;height:clamp(110px,26vh,250px)}
.hero .bee{position:absolute;height:clamp(50px,11vh,100px)}
.panel{flex:.8;max-width:560px;padding:3vh 2.4vw;text-align:center}
.panel h2{margin:0 0 1.2vh;font-size:clamp(20px,3.4vh,32px)}
.panel .lab{font-size:clamp(15px,2.4vh,22px);margin:1.6vh 0 .8vh;text-align:left}
.cls{display:flex;gap:.7vw;justify-content:center}
.cls button{font:inherit;font-size:clamp(18px,3.2vh,30px);width:clamp(52px,5.6vw,84px);aspect-ratio:1;border-radius:50%;border:4px solid var(--purple);background:#fff;color:var(--purple);cursor:pointer;box-shadow:0 5px 0 rgba(107,76,147,.25)}
.cls button.sel{background:var(--purple);color:#fff;transform:translateY(-3px)}
.nums{display:grid;grid-template-columns:repeat(5,1fr);gap:.7vh .7vw}
.nums button{font:inherit;font-size:clamp(15px,2.6vh,24px);padding:.45em 0;border-radius:16px;border:3px solid var(--sky-d);background:#fff;color:var(--ink);cursor:pointer}
.nums button.sel{background:var(--sun);border-color:var(--sun-d);transform:scale(1.08)}
.picked{margin:1.6vh 0 0;min-height:1.4em;font-size:clamp(16px,2.6vh,24px);color:var(--purple)}

/* ---------- tutorial ---------- */
#s-tut{background:linear-gradient(160deg,#FFE9A8,#BFE7F7)}
.tut{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(940px,92vw);padding:4vh 3vw;display:flex;gap:3vw;align-items:center}
.tut .mwrap{flex:0 0 28%;text-align:center}
.tut .mwrap svg{width:min(200px,100%);height:auto}
.tut .mwrap p{margin:1vh 0 0;font-size:clamp(13px,2.1vh,18px);color:var(--purple)}
.tut .txt{flex:1}
.tut .lv{display:inline-block;background:var(--purple);color:#fff;border-radius:30px;padding:.1em 1em;font-size:clamp(14px,2.4vh,22px)}
.tut h2{margin:1vh 0 1.4vh;font-size:clamp(24px,4.4vh,42px)}
.tut ol{margin:0 0 2vh;padding:0;list-style:none;counter-reset:s}
.tut li{counter-increment:s;position:relative;padding-left:2.1em;margin-bottom:1vh;font-size:clamp(16px,2.8vh,26px);line-height:1.45}
.tut li:before{content:counter(s);position:absolute;left:0;top:.05em;width:1.5em;height:1.5em;border-radius:50%;background:var(--sun);text-align:center;line-height:1.5em;font-size:.9em}
.tut li b{color:var(--coral-d)}
.tut .bees{position:absolute;right:-1vw;top:-5vh;height:12vh}
@keyframes fl{0%,100%{fill:#fff}50%{fill:#FFD54A}}
@keyframes fl2{0%,100%{fill:#fff}8%{fill:#FFD54A}18%{fill:#fff}28%{fill:#FFD54A}40%{fill:#fff}}
@keyframes fr{0%,30%{fill:#FFD54A}40%,100%{fill:#fff}}
@keyframes fl3{0%,50%{fill:#fff}60%,90%{fill:#FFD54A}100%{fill:#fff}}
@keyframes slide{0%,100%{transform:translateX(-26px)}50%{transform:translateX(26px)}}
.m-left .bl{animation:fl 1.1s infinite}
.m-double .bl{animation:fl2 1.8s infinite}
.m-right .br{animation:fl 1.1s infinite}
.m-rightleft .br{animation:fr 2.6s infinite}
.m-rightleft .bl{animation:fl3 2.6s infinite}
.m-drag .bl{fill:#FFD54A}
.m-drag .mbody{animation:slide 2s ease-in-out infinite}

/* ---------- play ---------- */
#hud{position:absolute;left:0;right:0;top:0;height:68px;z-index:60;display:flex;align-items:center;gap:1vw;padding:0 1.4vw;pointer-events:none}
#hud>*{pointer-events:auto}
.pill{background:rgba(255,255,255,.92);border:4px solid #fff;border-radius:40px;padding:.2em 1em;font-size:clamp(15px,2.6vh,24px);box-shadow:0 5px 0 rgba(47,58,69,.12)}
#hud-title{background:var(--purple);color:#fff}
#hud-count{background:var(--sun)}
#hud-time{background:#fff;min-width:5.2em;text-align:center}
#hud-time.low{background:var(--coral);color:#fff;animation:pulse .5s infinite}
#hud .sp{flex:1}
#hud .mini{font:inherit;font-size:clamp(15px,2.4vh,22px);border:4px solid #fff;background:rgba(255,255,255,.92);border-radius:40px;padding:.2em .8em;cursor:pointer;box-shadow:0 5px 0 rgba(47,58,69,.12)}
@keyframes pulse{50%{transform:scale(1.08)}}
.scene{position:absolute;inset:0;display:none;overflow:hidden}
.scene.on{display:block}

/* L1 */
#sc1{background:linear-gradient(180deg,#8FD3F0 0%,#D5F1FB 62%,#BFE8A8 62%,#8FCB77 100%)}
#sc1 .sunray{position:absolute;right:5vw;top:9vh;width:clamp(90px,16vh,160px)}
.spinrays{animation:spin 24s linear infinite;transform-origin:0 0}
@keyframes spin{to{transform:rotate(360deg)}}
#sc1 .cloud{position:absolute;background:#fff;border-radius:60px;opacity:.9;animation:drift linear infinite}
#sc1 .cloud:before,#sc1 .cloud:after{content:"";position:absolute;background:#fff;border-radius:50%}
#sc1 .cloud:before{width:46%;height:150%;left:12%;top:-60%}
#sc1 .cloud:after{width:34%;height:120%;left:52%;top:-40%}
@keyframes drift{from{transform:translateX(-30vw)}to{transform:translateX(130vw)}}
#sc1 .school-bg{position:absolute;left:50%;bottom:2vh;transform:translateX(-50%);height:38vh;opacity:.98;filter:drop-shadow(0 8px 6px rgba(0,0,0,.15))}
#sc1 #bl-layer{position:absolute;inset:0}
.balloon{position:absolute;left:0;top:0;cursor:pointer;will-change:transform}
.balloon svg{display:block;filter:drop-shadow(0 4px 3px rgba(0,0,0,.18))}
.balloon.pop svg{animation:pop .22s forwards}
@keyframes pop{to{transform:scale(1.7);opacity:0}}
#count1{position:absolute;inset:0;display:none;align-items:center;justify-content:center;font-size:20vh;color:#fff;text-shadow:0 8px 0 var(--purple),0 0 30px rgba(0,0,0,.25);z-index:40;background:rgba(255,255,255,.25)}
#count1.on{display:flex}

/* L2 */
#sc2{background:linear-gradient(180deg,#F6E7C8 0%,#F6E7C8 46%,#E2C792 46%,#E2C792 51%,#D6B27A 51%,#C79A5E 100%)}
#sc2 .ceil{position:absolute;left:0;right:0;top:0;height:11vh;background:#fff;border-bottom:6px solid #E2D6BA}
#sc2 .wallrow{position:absolute;left:0;right:0;top:15vh;height:26vh;display:flex;justify-content:space-around;align-items:center}
#sc2 .win{width:11vw;height:22vh;background:linear-gradient(180deg,#CBEBFA,#EAF8FF);border:6px solid #fff;border-radius:14px;box-shadow:0 0 0 4px #BFA97B inset}
#sc2 .board{width:9vw;height:14vh;background:#6FBF73;border:6px solid #A56B3C;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:2.2vh}
#sc2 .floorline{position:absolute;left:0;right:0;top:51%;height:6px;background:rgba(0,0,0,.08)}
#sc2 .school-tag{position:absolute;left:2vw;top:12vh;height:9vh;opacity:.0}
.person{position:absolute;left:0;top:0;cursor:pointer;will-change:transform}
.person .body{display:flex;flex-direction:column;align-items:center;animation:walk .55s ease-in-out infinite}
.person.flip .body .fig{transform:scaleX(-1)}
.person.stop .body{animation:none}
.person.hop .body{animation:hop .45s ease-in-out 3}
@keyframes walk{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes hop{0%,100%{transform:translateY(0)}50%{transform:translateY(-26px)}}
.person img.fig{display:block;pointer-events:none}
.person .emo{line-height:1}
.person .tag{font-size:clamp(12px,2vh,18px);padding:.05em .7em;border-radius:20px;background:#fff;color:var(--purple);margin-bottom:4px;border:3px solid var(--purple);white-space:nowrap}
.person.t .tag{background:var(--purple);color:#fff}
.person .bub{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:4px;background:#fff;border:4px solid var(--sun-d);border-radius:20px;padding:.15em .8em;font-size:clamp(16px,3vh,28px);white-space:nowrap;display:none;color:var(--ink);z-index:5}
.person.greeted .bub{display:block}
.person .star{position:absolute;right:-6px;top:10px;font-size:clamp(20px,4vh,36px);display:none}
.person.greeted .star{display:block}
.person.greeted{cursor:default}
#walkers{position:absolute;inset:0}

/* L3 */
#sc3{background:radial-gradient(circle at 50% 38%,#FFF4C2 0%,#FFE08A 38%,#FFC66B 100%)}
#sc3 .rays{position:absolute;left:50%;top:42%;width:150vmax;height:150vmax;margin:-75vmax 0 0 -75vmax;background:repeating-conic-gradient(rgba(255,255,255,.28) 0 7deg,transparent 7deg 18deg);animation:spin 40s linear infinite}
#sc3 .stage3{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(900px,96vw);height:min(560px,80vh);display:flex;align-items:flex-end;justify-content:center}
#sc3 .mascot{height:100%;position:absolute;left:4%;bottom:0}
#sc3 .say{position:absolute;left:38%;top:-2%;max-width:56%;background:#fff;border:5px solid var(--purple);border-radius:26px;padding:.4em 1em;font-size:clamp(17px,3.2vh,30px);z-index:3}
#sc3 .say:after{content:"";position:absolute;left:-22px;top:46%;border:12px solid transparent;border-right:14px solid var(--purple)}
#gift3{position:absolute;right:10%;bottom:5%;width:34%;cursor:pointer;animation:wob 1.6s ease-in-out infinite;transform-origin:50% 100%}
@keyframes wob{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}
#gift3.gone{display:none}
#reveal3{position:absolute;inset:0;z-index:20;display:none;align-items:center;justify-content:center;background:rgba(255,248,214,.88)}
#reveal3.on{display:flex}
#reveal3 .box{text-align:center;background:#fff;border:6px solid var(--sun-d);border-radius:40px;padding:3vh 5vw;animation:zoom .4s cubic-bezier(.3,1.6,.5,1)}
@keyframes zoom{from{transform:scale(.3);opacity:0}}
#reveal3 .big{font-size:20vh;line-height:1.1}
#reveal3 .nm{font-size:clamp(22px,5vh,48px);color:var(--purple)}

/* L4 */
#sc4{background:linear-gradient(180deg,#FFE3D1 0%,#FFE3D1 62%,#E9A877 62%,#C98457 100%)}
#sc4 .tiles{position:absolute;inset:0 0 38% 0;background:repeating-linear-gradient(90deg,transparent 0 11.9%,rgba(255,255,255,.55) 12% 12.2%),repeating-linear-gradient(0deg,transparent 0 24.5%,rgba(255,255,255,.55) 24.6% 25%);opacity:.8}
#tray4{position:absolute;left:5vw;top:24vh;width:36vw;height:46vh;background:linear-gradient(160deg,#E3E8EC,#B7C0C7);border:6px solid #8E99A2;border-radius:30px;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 0 rgba(0,0,0,.12)}
#tray4 .lbl{position:absolute;left:50%;top:-5.5vh;transform:translateX(-50%);background:#fff;border-radius:30px;padding:.1em 1em;font-size:clamp(14px,2.4vh,22px);border:4px solid var(--purple);color:var(--purple);white-space:nowrap}
#cookie4{width:46%;cursor:pointer;transition:transform .15s}
#cookie4:hover{transform:scale(1.06)}
#cookie4.newc{animation:zoom .4s cubic-bezier(.3,1.6,.5,1)}
#box4{position:absolute;right:5vw;top:24vh;width:36vw;height:46vh;cursor:pointer;background:linear-gradient(160deg,#FFB5A8,#FF7B6B);border:6px solid var(--coral-d);border-radius:26px;box-shadow:0 12px 0 rgba(0,0,0,.14);padding:2.4vh 2vw;display:grid;grid-template-columns:1fr 1fr;gap:2vh 2vw;transition:box-shadow .2s}
#box4 .lbl{position:absolute;left:50%;top:-5.5vh;transform:translateX(-50%);background:#fff;border-radius:30px;padding:.1em 1em;font-size:clamp(14px,2.4vh,22px);border:4px solid var(--coral-d);color:var(--coral-d);white-space:nowrap}
#box4.ready{box-shadow:0 0 0 8px var(--sun),0 0 40px 10px rgba(255,213,74,.8);animation:wob2 .9s ease-in-out infinite}
@keyframes wob2{50%{transform:scale(1.025)}}
#box4.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-10px)}75%{transform:translateX(10px)}}
#box4 .slot{background:rgba(255,255,255,.55);border:4px dashed #fff;border-radius:50%;display:flex;align-items:center;justify-content:center}
#box4 .slot svg{width:82%;animation:zoom .35s cubic-bezier(.3,1.6,.5,1)}
#clip4{position:absolute;left:50%;top:76vh;transform:translateX(-50%);display:flex;align-items:center;gap:.8vw;background:#fff;border:5px solid var(--purple);border-radius:40px;padding:.2em 1.2em;font-size:clamp(16px,2.8vh,26px);color:var(--purple)}
#clip4 svg{height:6vh;width:6vh}
#steps4{position:absolute;left:50%;top:86vh;transform:translateX(-50%);display:flex;gap:1.2vw;font-size:clamp(14px,2.4vh,22px)}
#steps4 span{white-space:nowrap;background:rgba(255,255,255,.75);border-radius:30px;padding:.2em 1em;border:4px solid transparent}
#steps4 span.now{background:var(--sun);border-color:var(--sun-d);transform:scale(1.08)}
#sc4 .bee4{position:absolute;height:12vh}

/* L5 */
#sc5{background:linear-gradient(180deg,#DCEFFB,#F4F9E8)}
.l5-left{position:absolute;left:1.4vw;top:76px;bottom:1.6vh;width:31vw;display:flex;flex-direction:column;gap:1.2vh}
.tt{flex:1;min-height:0;background:#fff;border:5px solid var(--purple);border-radius:22px;overflow:auto;box-shadow:0 7px 0 rgba(107,76,147,.2)}
.tt h3{margin:0;background:var(--purple);color:#fff;text-align:center;padding:.25em;font-size:clamp(15px,2.6vh,24px);position:sticky;top:0}
.tt table{width:100%;border-collapse:collapse;font-size:clamp(12px,2vh,17px)}
.tt td{padding:.18em .5em;border-bottom:2px solid #E7DEF2;line-height:1.25}
.tt td:first-child{color:#5C6B78;white-space:nowrap;width:44%}
.tt tr.hl td:last-child{background:#FFF1B8}
#bag{position:relative;height:36vh;background:rgba(255,255,255,.7);border:5px dashed var(--purple);border-radius:26px;display:flex;align-items:center;justify-content:center;transition:background .15s,transform .15s}
#bag.over{background:#FFF1B8;transform:scale(1.03)}
#bag svg{height:88%}
#bagcount{position:absolute;right:10px;top:8px;background:var(--sun);border-radius:30px;padding:.1em .8em;font-size:clamp(14px,2.4vh,22px)}
#bag.shake{animation:shake .35s}
.l5-right{position:absolute;left:34vw;right:1.4vw;top:76px;bottom:1.6vh;display:grid;grid-template-columns:repeat(4,1fr);gap:1.4vh 1vw;align-content:center}
.item{background:#fff;border:4px solid var(--sky-d);border-radius:22px;padding:1vh .4vw;text-align:center;cursor:grab;box-shadow:0 6px 0 rgba(124,199,232,.5);transition:transform .1s}
.item:hover{transform:translateY(-4px)}
.item .ic{height:clamp(54px,12vh,110px);display:flex;align-items:center;justify-content:center;font-size:clamp(40px,9vh,84px)}
.item .nm{font-size:clamp(14px,2.4vh,22px)}
.item.packed{opacity:.25;filter:grayscale(1);pointer-events:none}
.item.lift{opacity:.35}
.book{width:clamp(44px,8vh,76px);height:clamp(58px,11vh,100px);border-radius:6px 12px 12px 6px;border:4px solid rgba(0,0,0,.28);display:flex;align-items:center;justify-content:center;color:#fff;font-size:clamp(18px,3.8vh,34px);position:relative;box-shadow:inset 8px 0 0 rgba(0,0,0,.2)}
.ghost{position:fixed;z-index:300;pointer-events:none;cursor:grabbing;background:#fff;border:4px solid var(--sun-d);border-radius:22px;padding:1vh .8vw;text-align:center;box-shadow:0 14px 24px rgba(0,0,0,.28);transform:rotate(-4deg) scale(1.05);width:clamp(100px,12vw,170px)}
.ghost .ic{display:flex;justify-content:center;align-items:center;height:clamp(54px,11vh,100px);font-size:clamp(40px,8vh,76px)}
.ghost .nm{font-size:clamp(14px,2.3vh,20px)}


/* teacher mode */
.teacher-btn{position:absolute;right:2vw;top:2vh;z-index:5;font:inherit;font-size:clamp(14px,2.3vh,20px);padding:.4em 1.1em;border-radius:40px;border:4px solid #fff;background:var(--purple);color:#fff;cursor:pointer;box-shadow:0 5px 0 var(--purple-d)}
.teacher-btn:active{transform:translateY(3px);box-shadow:0 2px 0 var(--purple-d)}
#pwm{position:fixed;inset:0;z-index:250;display:none;align-items:center;justify-content:center;background:rgba(47,58,69,.55)}
#pwm.on{display:flex}
#pwm .card{padding:3.4vh 3vw;text-align:center;width:min(420px,90vw)}
#pwm h3{margin:0 0 1.4vh;font-size:clamp(20px,3.4vh,30px)}
#pwIn{width:100%;font-size:clamp(20px,3.4vh,30px);text-align:center;padding:.3em;border:4px solid var(--purple);border-radius:18px;letter-spacing:.3em}
#pwErr{min-height:1.6em;color:var(--coral-d);margin:1vh 0;font-size:clamp(14px,2.2vh,20px)}
#pwm .row{display:flex;gap:1vw;justify-content:center}
#s-teacher{background:linear-gradient(160deg,#EEE8F7,#DDF3FB);overflow:auto}
.tch{width:min(1100px,96vw);margin:0 auto;padding:2vh 0 4vh}
.tch-top{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1vh 1vw}
.tch-top h2{margin:0;font-size:clamp(22px,4vh,38px);color:var(--purple)}
.tch-btns{display:flex;gap:.6vw;flex-wrap:wrap}
.tch-btns button{font:inherit;font-size:clamp(13px,2.1vh,18px);padding:.35em 1em;border-radius:30px;border:3px solid var(--purple);background:#fff;color:var(--purple);cursor:pointer}
.tch-btns button.warn{border-color:var(--coral-d);color:var(--coral-d)}
.tch-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:.8vw;margin:2vh 0}
.cc{font:inherit;text-align:left;background:#fff;border:4px solid #fff;border-radius:20px;padding:1vh .9vw;cursor:pointer;display:flex;flex-direction:column;gap:.5vh;box-shadow:0 5px 0 rgba(47,58,69,.12);font-size:clamp(12px,1.9vh,16px);color:var(--ink)}
.cc b{font-size:clamp(20px,3.4vh,30px);color:var(--purple)}
.cc.sel{border-color:var(--purple);background:#F4EEFB}
.cc .bar{display:block;height:10px;border-radius:6px;background:#E6E9EC;overflow:hidden}
.cc .bar i{display:block;height:100%;background:var(--leaf)}
.tch-tbl{padding:1vh 1vw;overflow:auto}
.tch-tbl table{width:100%;border-collapse:collapse;font-size:clamp(13px,2.1vh,18px);text-align:center}
.tch-tbl th{background:var(--purple);color:#fff;padding:.4em .3em;position:sticky;top:0}
.tch-tbl td{padding:.28em .3em;border-bottom:2px solid #EEE8F7}
.tch-tbl td.g0{color:#B5BCC3}.tch-tbl td.g1{background:#FFF1C9}.tch-tbl td.g2{background:#E1F4D4}.tch-tbl td.g3{background:#C4EBB0}
.tch-tbl tfoot td{background:#F4EEFB;border-top:3px solid var(--purple)}
.st0{color:#A7AEB5}.st1{color:#C98A00}.st2{color:var(--leaf-d)}
.tch-note{font-size:clamp(12px,1.9vh,16px);color:#5C6B78;margin:1.4vh 0 0;line-height:1.6}
.sc{font-size:clamp(18px,3vh,28px);margin:.4vh 0 1.4vh}
@media(max-width:800px){.tch-cards{grid-template-columns:repeat(2,1fr)}}

/* result + cert */
#s-res{background:linear-gradient(160deg,#FFF3C4,#CFEFC6)}
.res{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(700px,92vw);padding:4vh 3vw;text-align:center}
.res .pic{height:clamp(140px,30vh,300px)}
.res h2{margin:1vh 0;font-size:clamp(28px,5.4vh,52px)}
.res p{margin:0 0 2vh;font-size:clamp(17px,3vh,28px);line-height:1.5}
.res .row{display:flex;gap:1.4vw;justify-content:center;flex-wrap:wrap}
#s-cert{background:linear-gradient(160deg,#DDF3FB,#FFF3C4);overflow:auto}
.cert{position:relative;margin:2vh auto;width:min(860px,94vw);padding:3.4vh 3vw 3vh;background:#fff;border:10px double var(--sun-d);border-radius:26px;text-align:center;box-shadow:0 14px 30px rgba(0,0,0,.16)}
.cert .bld{height:clamp(70px,14vh,130px)}
.cert h2{margin:.6vh 0;font-size:clamp(28px,6vh,56px);color:var(--purple)}
.cert .who{display:inline-block;min-width:min(420px,80%);margin:1vh 0;padding:.1em 1em;border-bottom:5px solid var(--ink);font-size:clamp(26px,5.4vh,50px)}
.cert p{margin:.7vh 0;font-size:clamp(15px,2.6vh,24px)}
.cert .skills{display:flex;justify-content:center;gap:1vw;flex-wrap:wrap;margin:1.4vh auto;max-width:62%}
.cert .skills span{background:var(--sky);border-radius:30px;padding:.2em .9em;font-size:clamp(14px,2.4vh,22px)}
.cert .kid{position:absolute;bottom:2vh;height:clamp(90px,17vh,150px)}
.cert .bee{position:absolute;top:2vh;height:clamp(44px,9vh,80px)}
.cert .row{display:flex;gap:1.4vw;justify-content:center;margin-top:2vh}
@media print{body{background:#fff;overflow:visible}.row,#hint{display:none!important}.cert{box-shadow:none;margin:0 auto}}
</style>
</head>
<body>

<div id="hint"></div>
<div id="ctx"></div>

<!-- HOME -->
<section id="s-home" class="screen on">
  <button class="teacher-btn" id="teacherBtn">👩‍🏫 老師版</button>
  <div class="home-wrap">
    <div class="hero" id="hero"></div>
    <div class="panel card">
      <h2>你係邊一班呀？</h2>
      <div class="lab">班別</div>
