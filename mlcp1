function runL1(){
  const layer=$('bl-layer'); layer.innerHTML='';
  $('bg1').src=IMG.bld2;
  let rays=''; for(let i=0;i<12;i++){ rays+=`<path d="M-9 -58L0 -92L9 -58Z" fill="#FFB02E" transform="rotate(${i*30})"/>`; }
  $('sunrays').innerHTML=rays;
  const GOAL=12, TIME=60;
  let got=0, left=TIME, bl=[], spawnT=0, last=0, raf=0, live=false, dead=false;
  setCount(`🎈 0 / ${GOAL}`); $('hud-time').textContent=`⏱ ${TIME}`;
  const cd=$('count1'); cd.classList.add('on');
  let c=3; cd.textContent=c; sfx.tick();
  const cdT=setInterval(()=>{ c--; if(c>0){cd.textContent=c;sfx.tick();} else { clearInterval(cdT); cd.textContent='開始！'; sfx.good(); setTimeout(()=>{cd.classList.remove('on'); live=true; last=performance.now(); raf=requestAnimationFrame(frame);},450);} },800);
  function spawn(){
    const W=layer.clientWidth, H=layer.clientHeight;
    const col=pick(BCOL), el=document.createElement('div'); el.className='balloon'; el.innerHTML=balloonSVG(col);
    const b={el,x:rnd(10,W-90),y:H+20,sp:rnd(95,135),ph:rnd(0,6),amp:rnd(8,26)};
    el.addEventListener('click',()=>{
      if(b.gone) return; b.gone=true; el.classList.add('pop'); got++; sfx.pop(got); setCount(`🎈 ${got} / ${GOAL}`);
      setTimeout(()=>el.remove(),230);
      if(got%5===0 && got<GOAL){ hint('🚀 加速喇！氣球升得更快！',true); }
      if(got>=GOAL){ live=false; cancelAnimationFrame(raf); setTimeout(()=>passLevel(1,12+Math.min(8,Math.round(left/5))),500); }
    });
    el.addEventListener('contextmenu',()=>{cur.mis++;hint('要用左邊嗰粒掣（左CLICK）呀！',false);});
    layer.appendChild(el); bl.push(b);
  }
  function frame(now){
    if(!live) return;
    const dt=Math.min(.05,(now-last)/1000); last=now;
    left-=dt; spawnT-=dt;
    const mul=1+.38*Math.floor(got/5);
    if(spawnT<=0){ spawn(); spawnT=Math.max(.35,.8/Math.sqrt(mul)); }
    bl=bl.filter(b=>{
      if(b.gone) return false;
      b.y-=b.sp*mul*dt; b.ph+=dt*1.6;
      b.el.style.transform=`translate(${b.x+Math.sin(b.ph)*b.amp}px,${b.y}px)`;
      if(b.y<-130){ b.el.remove(); return false; }
      return true;
    });
    const s=Math.max(0,Math.ceil(left)); $('hud-time').textContent=`⏱ ${s}`; $('hud-time').classList.toggle('low',s<=10);
    if(left<=0){ live=false; failLevel(1,'⏰ 時間到！',`今次收集咗 ${got} 個氣球，要12個先過關。再試一次啦！`); return; }
    raf=requestAnimationFrame(frame);
  }
  cur.stop=()=>{ live=false; dead=true; clearInterval(cdT); cancelAnimationFrame(raf); layer.innerHTML=''; cd.classList.remove('on'); };
}

/* ====================== LEVEL 2 : double click greetings ====================== */
function runL2(){
  const st=$('sc2'), layer=$('walkers'); layer.innerHTML='';
  const GOAL=10; let got=0, people=[], spawnT=0, last=performance.now(), raf=0, run=true;
  setCount(`👋 0 / ${GOAL}`);
  const KINDS=[{t:'s',k:'boystand'},{t:'s',k:'boystand2'},{t:'s',k:'girlhair'},{t:'s',k:'boystand'},{t:'s',k:'girlhair'},{t:'t',k:'t1',f:1.12},{t:'t',k:'t2',f:1.12},{t:'t',k:'t3',f:1.12}];
  const SAY_S=['早晨！','你好！','Hi！','你好呀！','早晨呀！'], SAY_T=['老師早晨！','老師你好！','Good morning, teacher!'];
  function spawn(){
    const W=st.clientWidth, H=st.clientHeight, k=pick(KINDS), dir=Math.random()<.5?1:-1;
    const hgt=Math.min(H*.36,260)*(k.f||1), el=document.createElement('div');
    el.className='person '+k.t+(dir<0?' flip':'');
    const fig = k.k ? `<img class="fig" src="${IMG[k.k]}" style="height:${hgt}px">` : `<div class="fig emo" style="font-size:${hgt*.62}px;height:${hgt}px;display:flex;align-items:flex-end">${k.e}</div>`;
    el.innerHTML=`<div class="bub"></div><div class="star">⭐</div><div class="body"><div class="tag">${k.t==='t'?'老師':'同學'}</div>${fig}</div>`;
    const feet=H*(.62+rnd(0,.2)), p={el,dir,sp:rnd(70,125),x:dir>0?-200:W+60,y:feet-hgt-26,pause:0,greeted:false,kind:k.t,hgt};
    el.style.zIndex=Math.round(feet);
    let ct=0;
    el.addEventListener('dblclick',e=>{ e.preventDefault(); clearTimeout(ct); greet(p); });
    el.addEventListener('click',e=>{ if(p.greeted||e.detail>1) return; clearTimeout(ct); ct=setTimeout(()=>{cur.mis++;hint('要連續快速㩒兩下（雙CLICK）呀！',false);},380); });
    layer.appendChild(el); people.push(p);
  }
  function greet(p){
    if(p.greeted||!run) return;
    p.greeted=true; p.pause=1.6; got++; sfx.good(); setCount(`👋 ${got} / ${GOAL}`);
    const el=p.el; el.querySelector('.bub').textContent = p.kind==='t'?pick(SAY_T):pick(SAY_S);
    el.classList.add('greeted','stop','hop'); setTimeout(()=>el.classList.remove('stop','hop'),1600);
    if(got>=GOAL){ run=false; setTimeout(()=>passLevel(2),1200); }
  }
  function frame(now){
    if(!run) return;
    const dt=Math.min(.05,(now-last)/1000); last=now, W=st.clientWidth;
    spawnT-=dt; if(spawnT<=0 && people.filter(q=>!q.greeted).length<4){ spawn(); spawnT=rnd(.8,1.5); }
    people=people.filter(p=>{
      if(p.pause>0){ p.pause-=dt; }
      else p.x+=p.dir*p.sp*dt;
      p.el.style.transform=`translate(${p.x}px,${p.y}px)`;
      if((p.dir>0&&p.x>W+120)||(p.dir<0&&p.x<-300)){ p.el.remove(); return false; }
      return true;
    });
    raf=requestAnimationFrame(frame);
  }
  spawn(); people[0].x=st.clientWidth*.15; spawnT=.6;
  raf=requestAnimationFrame(frame);
  cur.stop=()=>{ run=false; cancelAnimationFrame(raf); layer.innerHTML=''; };
}

