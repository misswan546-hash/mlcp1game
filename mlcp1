function cookieSVG(c){
  const d=[[34,34],[62,28],[48,52],[72,58],[30,64],[56,76],[78,36],[44,22]]; 
  const dots=d.map((p,i)=>`<circle cx="${p[0]}" cy="${p[1]}" r="${i%2?5:6.5}" fill="${c.dots[i%c.dots.length]}"/>`).join('');
  return `<svg viewBox="0 0 100 100" style="width:100%;display:block"><path d="M50 5c8 0 12 5 19 6 7 1 13 4 16 11 3 7 1 12 5 18 3 6 4 12 0 18-3 6-1 12-6 17-5 5-11 4-17 8-6 4-12 7-19 7s-13-3-19-7c-6-4-12-3-17-8-5-5-3-11-6-17-4-6-3-12 0-18 4-6 2-11 5-18 3-7 9-10 16-11 7-1 11-6 23-6z" fill="${c.base}" stroke="#8A5A2B" stroke-width="4" stroke-linejoin="round"/>${dots}</svg>`;
}
function runL4(){
  const GOAL=4; let n=0, clip=null, ci=0, order=shuffle(COOKIES), timers=[];
  const ck=$('cookie4'), box=$('box4'), clipEl=$('clip4');
  box.querySelectorAll('.slot').forEach(s=>s.remove());
  for(let i=0;i<GOAL;i++){ const s=document.createElement('div'); s.className='slot'; box.appendChild(s); }
  setCount(`🍪 0 / ${GOAL}`);
  function steps(s){ document.querySelectorAll('#steps4 span').forEach(x=>x.classList.toggle('now',+x.dataset.s===s)); }
  function renderClip(){ clipEl.innerHTML = clip ? `📋 已經複製：${cookieSVG(clip)}<b>${clip.name}</b>` : '📋 剪貼簿：（空）'; box.classList.toggle('ready',!!clip); }
  function newCookie(){ clip=null; ck.innerHTML=cookieSVG(order[ci%4]); ck.classList.remove('newc'); void ck.offsetWidth; ck.classList.add('newc'); renderClip(); steps(1); }
  function shakeBox(){ box.classList.remove('shake'); void box.offsetWidth; box.classList.add('shake'); }
  function paste(){
    if(!clip){ cur.mis++; shakeBox(); sfx.bad(); hint('未複製曲奇呀！先右CLICK曲奇，揀「複製」',false); steps(1); return; }
    const slot=box.querySelectorAll('.slot')[n]; slot.innerHTML=cookieSVG(clip); n++; ci++; sfx.good(); setCount(`🍪 ${n} / ${GOAL}`);
    if(n>=GOAL){ clip=null; renderClip(); steps(0); timers.push(setTimeout(()=>passLevel(4),1000)); }
    else { hint('貼上咗！再做多一次',true); newCookie(); }
  }
  ck.oncontextmenu=e=>{
    e.preventDefault();
    showCtx(e.clientX,e.clientY,[
      {label:'✂️ 剪下',fn:()=>{ cur.mis++; sfx.bad(); hint('「剪下」會令曲奇不見！要揀「複製」呀',false); }},
      {label:'📄 複製',fn:()=>{ clip=order[ci%4]; sfx.good(); renderClip(); steps(3); hint('複製咗喇！而家右CLICK曲奇盒',true); }},
      {label:'🗑️ 刪除',fn:()=>{ cur.mis++; sfx.bad(); hint('「刪除」會丟咗曲奇！要揀「複製」呀',false); }}
    ]);
    steps(2);
  };
  ck.onclick=()=>{ cur.mis++; hint('曲奇要用右CLICK先會彈出選單呀！',false); };
  box.oncontextmenu=e=>{
    e.preventDefault();
    showCtx(e.clientX,e.clientY,[{label:'📋 貼上',fn:paste}]);
    if(clip) steps(4);
  };
  box.onclick=()=>{ cur.mis++; shakeBox(); sfx.bad(); hint(clip?'要用右CLICK曲奇盒，再揀「貼上」呀！':'先右CLICK曲奇，揀「複製」呀！',false); };
  newCookie();
  cur.stop=()=>{ timers.forEach(clearTimeout); ck.oncontextmenu=null; ck.onclick=null; box.onclick=null; box.oncontextmenu=null; box.classList.remove('ready'); };
}

