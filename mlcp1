    <div class="who">${me.cls}班　${me.no}號</div>
    <p>完成咗「滑鼠小教室」全部五個關卡，<br>已經學識曬滑鼠嘅基本操作！</p>
    <div class="skills"><span>👈 左CLICK</span><span>👆👆 雙CLICK</span><span>👉 右CLICK</span><span>📋 複製貼上</span><span>✋ 拖曳</span></div>
    <p>總分：<b>${recTotal(getMine(loadRec()))} / 100</b></p>
    <p>${d}</p>
    ${img('boystand','kid','left:3%')}${img('girlhair','kid','right:3%')}
    <div class="row"><button class="btn green" onclick="window.print()">🖨️ 列印證書</button><button class="btn purple" onclick="show('s-home')">🏠 返回首頁</button></div>
  </div>`;
  show('s-cert'); confettiBurst();
}
function confettiBurst(){
  const cols=['#FF7B6B','#FFD54A','#6FBF73','#6B4C93','#7CC7E8'];
  for(let i=0;i<60;i++){
    const c=document.createElement('div');
    c.style.cssText=`position:fixed;top:-20px;left:${rnd(0,100)}vw;width:12px;height:12px;border-radius:3px;background:${pick(cols)};z-index:400;pointer-events:none;transition:transform ${rnd(2,3.6)}s linear,opacity .5s`;
    document.body.appendChild(c);
    requestAnimationFrame(()=>requestAnimationFrame(()=>{ c.style.transform=`translate(${rnd(-80,80)}px,110vh) rotate(${rnd(200,720)}deg)`; }));
    setTimeout(()=>c.remove(),4200);
  }
}


/* ---------- records ---------- */
const REC_KEY='mouseGameRecords_v1'; let memRec={};
function loadRec(){ try{ const s=localStorage.getItem(REC_KEY); if(s) memRec=JSON.parse(s)||{}; }catch(e){} return memRec; }
function saveRec(r){ memRec=r; try{ localStorage.setItem(REC_KEY,JSON.stringify(r)); }catch(e){} }
const rkey=(c,n)=>c+'-'+n;
function getMine(r){ const k=rkey(me.cls,me.no); return r[k]||(r[k]={cls:me.cls,no:me.no,lv:{},plays:0,last:0}); }
const recTotal=m=>[1,2,3,4,5].reduce((a,i)=>a+((m.lv&&m.lv[i])||0),0);
function recStart(){ const r=loadRec(), m=getMine(r); m.plays++; m.last=Date.now(); saveRec(r); }
function recLevel(n,score){ const r=loadRec(), m=getMine(r); m.lv[n]=Math.max(m.lv[n]||0,score); m.last=Date.now(); saveRec(r); return recTotal(m); }

/* ---------- teacher mode ---------- */
const CLASSES=['1A','1B','1C','1D','1E'];
let tchCls='1A';
const statOf=m=>{ if(!m) return 0; const d=[1,2,3,4,5].filter(i=>m.lv[i]).length; return d===5?2:((d>0||m.plays>0)?1:0); };
const STTXT=['未玩','進行中','✅ 全部完成'];
function openPw(){ $('pwm').classList.add('on'); $('pwIn').value=''; $('pwErr').textContent=''; setTimeout(()=>$('pwIn').focus(),60); }
function checkPw(){
  if($('pwIn').value==='1234'){ $('pwm').classList.remove('on'); renderTch(); show('s-teacher'); }
  else { $('pwErr').textContent='密碼唔啱，再試下'; $('pwIn').value=''; $('pwIn').focus(); }
}
function renderTch(){
  const r=loadRec();
  $('tchCards').innerHTML=CLASSES.map(c=>{
    let done=0,started=0; for(let i=1;i<=25;i++){ const s=statOf(r[rkey(c,i)]); if(s===2) done++; if(s>=1) started++; }
    return `<button class="cc ${c===tchCls?'sel':''}" data-c="${c}"><b>${c}班</b><span>全部完成：${done} / 25</span><span class="bar"><i style="width:${done*4}%"></i></span><span>已開始：${started} 人</span></button>`;
  }).join('');
  document.querySelectorAll('#tchCards .cc').forEach(b=>b.onclick=()=>{ tchCls=b.dataset.c; renderTch(); });
  const cellCls=v=>!v?'g0':v>=18?'g3':v>=15?'g2':'g1';
  let rows='', cnt=[0,0,0,0,0,0];
  for(let i=1;i<=25;i++){
    const m=r[rkey(tchCls,i)], s=statOf(m);
    let tds=''; for(let l=1;l<=5;l++){ const v=m&&m.lv[l]; if(v) cnt[l]++; tds+=`<td class="${cellCls(v)}">${v||'—'}</td>`; }
    rows+=`<tr><td><b>${i}</b></td>${tds}<td><b>${m?recTotal(m):'—'}</b></td><td class="st${s}">${STTXT[s]}</td><td>${m&&m.plays?m.plays:'—'}</td></tr>`;
  }
  $('tchTable').innerHTML=`<thead><tr><th>${tchCls}班 學號</th><th>第1關<br>左CLICK</th><th>第2關<br>雙CLICK</th><th>第3關<br>右CLICK</th><th>第4關<br>複製貼上</th><th>第5關<br>拖曳</th><th>總分<br>(最高分)</th><th>狀態</th><th>遊玩<br>次數</th></tr></thead><tbody>${rows}</tbody>
    <tfoot><tr><td>完成人數</td>${[1,2,3,4,5].map(l=>`<td>${cnt[l]} / 25</td>`).join('')}<td colspan="3"></td></tr></tfoot>`;
}
function dl(name,text,bom){ const b=new Blob([(bom?'\ufeff':'')+text],{type:'text/plain;charset=utf-8'}); const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download=name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),1500); }
function exportCsv(){
  const r=loadRec(); let out='班別,學號,第1關,第2關,第3關,第4關,第5關,總分(最高分),狀態,遊玩次數\n';
  CLASSES.forEach(c=>{ for(let i=1;i<=25;i++){ const m=r[rkey(c,i)]; const s=statOf(m);
    out+=[c,i,...[1,2,3,4,5].map(l=>(m&&m.lv[l])||''),m?recTotal(m):'',STTXT[s].replace('✅ ',''),(m&&m.plays)||''].join(',')+'\n'; } });
  dl('滑鼠小教室_學生紀錄.csv',out,true);
}
function mergeRec(inc){
  const r=loadRec();
  Object.keys(inc||{}).forEach(k=>{ const a=inc[k]; if(!a||!a.cls) return; const b=r[k]||(r[k]={cls:a.cls,no:a.no,lv:{},plays:0,last:0});
    [1,2,3,4,5].forEach(l=>{ b.lv[l]=Math.max(b.lv[l]||0,(a.lv&&a.lv[l])||0)||undefined; if(!b.lv[l]) delete b.lv[l]; });
    b.plays=Math.max(b.plays||0,a.plays||0); b.last=Math.max(b.last||0,a.last||0); });
  saveRec(r);
}
$('teacherBtn').onclick=openPw;
$('pwOk').onclick=checkPw; $('pwCancel').onclick=()=>$('pwm').classList.remove('on');
$('pwIn').addEventListener('keydown',e=>{ if(e.key==='Enter') checkPw(); if(e.key==='Escape') $('pwm').classList.remove('on'); });
$('tBack').onclick=()=>show('s-home');
$('tExpCsv').onclick=exportCsv;
$('tExpJson').onclick=()=>dl('滑鼠小教室_紀錄備份.json',JSON.stringify(loadRec()),false);
$('tImp').onclick=()=>$('impFile').click();
$('impFile').onchange=e=>{ const f=e.target.files[0]; if(!f) return; const rd=new FileReader();
  rd.onload=()=>{ try{ mergeRec(JSON.parse(rd.result)); renderTch(); hint('匯入成功，已合併紀錄（每關保留最高分）',true); }catch(err){ hint('檔案格式唔啱，匯入失敗',false); } e.target.value=''; };
  rd.readAsText(f); };
$('tClear').onclick=()=>{ if(confirm('確定清除所有學生紀錄？清除後無法復原。')){ saveRec({}); renderTch(); hint('已清除所有紀錄',true); } };

buildHome();
</script>
