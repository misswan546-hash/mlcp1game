    <div id="steps4"><span data-s="1">① 右CLICK曲奇</span><span data-s="2">② 揀「複製」</span><span data-s="3">③ 右CLICK曲奇盒</span><span data-s="4">④ 左CLICK「貼上」</span></div>
  </div>

  <div id="sc5" class="scene">
    <div class="l5-left">
      <div class="tt"><h3>📅 今日：星期一</h3><table id="tt5"></table></div>
      <div id="bag"><span id="bagcount"></span></div>
    </div>
    <div class="l5-right" id="items5"></div>
  </div>
</section>

<!-- TEACHER -->
<section id="s-teacher" class="screen">
  <div class="tch">
    <div class="tch-top">
      <h2>👩‍🏫 老師版：學生完成情況</h2>
      <div class="tch-btns">
        <button id="tExpCsv">⬇ 匯出 CSV</button>
        <button id="tExpJson">💾 匯出備份</button>
        <button id="tImp">📂 匯入備份</button>
        <button class="warn" id="tClear">🗑 清除紀錄</button>
        <button id="tBack">🏠 返回首頁</button>
        <input type="file" id="impFile" accept=".json,application/json" hidden>
      </div>
    </div>
    <div class="tch-cards" id="tchCards"></div>
    <div class="tch-tbl card"><table id="tchTable"></table></div>
    <p class="tch-note">每關滿分 20 分，總分滿分 100 分。同一位學生玩多次，每關只記錄<b>最高分</b>。「—」代表未完成該關。<br>紀錄儲存喺呢部電腦嘅瀏覽器入面；如果學生用唔同電腦玩，可以用「匯出備份」同「匯入備份」將紀錄合併。</p>
  </div>
</section>

<div id="pwm"><div class="card">
  <h3>🔒 老師版</h3>
  <input id="pwIn" type="password" inputmode="numeric" autocomplete="off" placeholder="輸入密碼">
  <div id="pwErr"></div>
  <div class="row"><button class="btn small purple" id="pwOk">進入</button><button class="btn small" id="pwCancel" style="background:#8C98A3;box-shadow:0 5px 0 #6B7782">取消</button></div>
</div></div>

<!-- RESULT -->
<section id="s-res" class="screen"><div class="res card" id="res"></div></section>

<!-- CERTIFICATE -->
<section id="s-cert" class="screen"><div id="certwrap"></div></section>

<script>
const IMG = {"t1": "data:image/png;base64,", "t2": "data:image/png;base64,", "t3": "data:image/png;base64,", "bee1": "data:image/png;base64,", "bee2": "data:image/png;base64,", "bld1": "data:image/png;base64,", "bld2": "data:image/png;base64,", "bld3": "data:image/png;base64,", "boystand": "data:image/png;base64,", "boystand2": "data:image/png;base64,", "girlhair": "data:image/png;base64,", "boyjump": "data:image/png;base64,", "girljump": "data:image/png;base64,", "girljump2": "data:image/png;base64,"};
const $ = id => document.getElementById(id);
const rnd = (a,b) => Math.random()*(b-a)+a;
const pick = a => a[Math.floor(Math.random()*a.length)];
const shuffle = a => { a=a.slice(); for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; };
const img = (k,cls='',st='') => `<img src="${IMG[k]}" class="${cls}" style="${st}" alt="">`;

/* ---------- sound ---------- */
let muted=false, ac=null;
function tone(f,d=.1,t='sine',v=.07,delay=0){
  if(muted) return;
  try{
    ac = ac || new (window.AudioContext||window.webkitAudioContext)();
    const o=ac.createOscillator(), g=ac.createGain(); o.type=t; o.frequency.value=f;
    o.connect(g); g.connect(ac.destination);
    const s=ac.currentTime+delay; g.gain.setValueAtTime(v,s); g.gain.exponentialRampToValueAtTime(.0001,s+d);
    o.start(s); o.stop(s+d+.02);
  }catch(e){}
}
const sfx = {
  pop:n=>tone(480+n*45,.11,'sine'),
  good:()=>{tone(660,.1,'triangle');tone(880,.15,'triangle',.07,.1);},
  bad:()=>tone(190,.2,'sawtooth',.05),
  win:()=>[523,659,784,1046].forEach((f,i)=>tone(f,.2,'triangle',.07,i*.12)),
  tick:()=>tone(880,.06,'square',.03),
  fail:()=>[392,330,262].forEach((f,i)=>tone(f,.25,'triangle',.07,i*.18))
};

/* ---------- helpers ---------- */
let hintT;
function hint(msg,ok){ const h=$('hint'); h.textContent=msg; h.className='show '+(ok?'ok':'no'); clearTimeout(hintT); hintT=setTimeout(()=>h.className='',1900); }
function show(id){ $('hint').className=''; document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on')); $(id).classList.add('on'); }
function showScene(n){ document.querySelectorAll('.scene').forEach(s=>s.classList.remove('on')); $('sc'+n).classList.add('on'); }
document.addEventListener('contextmenu', e=>e.preventDefault());

function showCtx(x,y,items){
  const m=$('ctx'); m.innerHTML='';
  items.forEach(it=>{ const b=document.createElement('button'); b.textContent=it.label; b.onclick=ev=>{ev.stopPropagation(); hideCtx(); it.fn();}; m.appendChild(b); });
  m.classList.add('on');
  const r=m.getBoundingClientRect();
  m.style.left=Math.min(x,innerWidth-r.width-8)+'px';
  m.style.top=Math.min(y,innerHeight-r.height-8)+'px';
}
function hideCtx(){ $('ctx').classList.remove('on'); }
document.addEventListener('mousedown', e=>{ if(!$('ctx').contains(e.target)) hideCtx(); });
document.addEventListener('keydown', e=>{ if(e.key==='Escape') hideCtx(); });

/* ---------- state ---------- */
const me = {cls:'', no:0};
let cur = {n:0, stop:null};

/* ---------- home ---------- */
function buildHome(){
  $('hero').innerHTML = `
    ${img('bee1','bee float','left:2%;top:4%;animation-delay:-.5s')}
    ${img('bee2','bee float','right:6%;top:0;animation-delay:-1.6s')}
    <h1>滑鼠小教室</h1>
    <div class="school">港澳信義會小學 · 小一電腦學習</div>
    ${img('bld1','bld')}
    <div class="kids">${img('boystand')}${img('girlhair')}${img('boystand2')}</div>
    ${img('boyjump','jump float','left:-3%;bottom:20%;animation-delay:-1s')}
    ${img('girljump2','jump float','right:-2%;bottom:18%;animation-delay:-2s')}`;
  ['1A','1B','1C','1D','1E'].forEach(c=>{
    const b=document.createElement('button'); b.textContent=c; b.onclick=()=>{ me.cls=c; updPick(); }; b.dataset.c=c; $('clsbtns').appendChild(b);
  });
  for(let i=1;i<=25;i++){
    const b=document.createElement('button'); b.textContent=i; b.onclick=()=>{ me.no=i; updPick(); }; b.dataset.n=i; $('numbtns').appendChild(b);
  }
  $('startBtn').onclick=()=>{ sfx.good(); recStart(); openTut(1); };
}
function updPick(){
  document.querySelectorAll('#clsbtns button').forEach(b=>b.classList.toggle('sel',b.dataset.c===me.cls));
  document.querySelectorAll('#numbtns button').forEach(b=>b.classList.toggle('sel',+b.dataset.n===me.no));
  $('picked').textContent = (me.cls&&me.no) ? `你好！${me.cls}班 ${me.no}號 👋` : '請先揀班別同學號';
  $('startBtn').disabled = !(me.cls&&me.no);
  sfx.pop(1);
}

/* ---------- tutorial ---------- */
const LV = {
 1:{icon:'🎈',name:'左CLICK 收集氣球',mouse:'left',cap:'閃住嘅就係要㩒嘅掣',
    steps:['移動滑鼠，將箭嘴指住氣球','用食指㩒一下滑鼠<b>左邊</b>嗰粒掣（左CLICK）','<b>1分鐘</b>內收集 <b>12</b> 個氣球就過關！每收集5個，氣球會升得快啲']},
 2:{icon:'👋',name:'雙CLICK 向人打招呼',mouse:'double',cap:'連續快速㩒兩下',
    steps:['返學途中，走廊會遇到老師同同學','將箭嘴指住佢哋','用左邊嗰粒掣<b>連續快速㩒兩下</b>（雙CLICK）','成功打 <b>10</b> 次招呼就過關！']},
 3:{icon:'🎁',name:'右CLICK 打開禮物',mouse:'right',cap:'今次㩒右邊嗰粒掣',
    steps:['陽光達人送咗禮物俾你','將箭嘴指住禮物','㩒滑鼠<b>右邊</b>嗰粒掣（右CLICK）','喺彈出嚟嘅選單揀「<b>打開</b>」','打開 <b>5</b> 份禮物就過關！']},
 4:{icon:'🍪',name:'複製同貼上 製作曲奇',mouse:'rightleft',cap:'右CLICK出選單，左CLICK揀選項',
    steps:['喺曲奇上面<b>右CLICK</b>，喺選單揀「<b>複製</b>」','喺曲奇盒上面<b>右CLICK</b>','喺選單用<b>左CLICK</b>揀「<b>貼上</b>」，曲奇就會跑入盒','曲奇盒裝滿 <b>4</b> 塊曲奇就過關！']},
 5:{icon:'🎒',name:'拖曳 執書包',mouse:'drag',cap:'㩒住左邊掣，再移動滑鼠',
    steps:['睇睇左邊嘅時間表（今日係星期一）','將箭嘴指住用品，<b>㩒住左邊掣唔好放</b>','移動滑鼠，將用品拖到書包上面先放手','將上課要用嘅 <b>7</b> 樣用品放入書包！']}
};
function mouseSVG(mode){
  return `<svg class="m-${mode}" viewBox="0 0 220 270" width="200"><g class="mbody">
   <path d="M32 112C32 36 188 36 188 112V176C188 244 32 244 32 176Z" fill="#fff" stroke="#2F3A45" stroke-width="7"/>
   <path class="bl" d="M36 110C36 62 76 44 106 44V110Z" fill="#fff"/>
   <path class="br" d="M184 110C184 62 144 44 114 44V110Z" fill="#fff"/>
   <path d="M32 112H188M110 42V112" stroke="#2F3A45" stroke-width="7" fill="none"/>
   <rect x="100" y="60" width="20" height="36" rx="10" fill="#BFE7F7" stroke="#2F3A45" stroke-width="5"/>
   <text x="70" y="98" font-size="34" text-anchor="middle" fill="#2F3A45" font-family="sans-serif" font-weight="700">左</text>
   <text x="150" y="98" font-size="34" text-anchor="middle" fill="#2F3A45" font-family="sans-serif" font-weight="700">右</text>
   <path d="M30 170C60 232 160 232 190 170" fill="none" stroke="#E7DEF2" stroke-width="5"/>
  </g></svg>`;
}
function openTut(n){
  stopCur(); cur.n=n; const L=LV[n];
  $('tut').innerHTML = `
    ${img('bee1','bees float')}
    <div class="mwrap">${mouseSVG(L.mouse)}<p>${L.cap}</p></div>
    <div class="txt">
      <span class="lv">第 ${n} 關 / 共 5 關</span>
      <h2>${L.icon} ${L.name}</h2>
      <ol>${L.steps.map(s=>`<li>${s}</li>`).join('')}</ol>
      <button class="btn" id="goBtn">開始 ▶</button>
    </div>`;
  $('goBtn').onclick=()=>startLevel(n);
  show('s-tut');
}

/* ---------- level control ---------- */
function stopCur(){ if(cur.stop){ try{cur.stop();}catch(e){} cur.stop=null; } hideCtx(); }
function setHud(n){
  const L=LV[n];
  $('hud-title').textContent=`第${n}關 ${L.icon}`;
  $('hud-me').textContent=`${me.cls} · ${me.no}號`;
  $('hud-time').style.display = n===1 ? '' : 'none';
  $('hud-time').classList.remove('low');
}
function setCount(txt){ $('hud-count').textContent=txt; }
function startLevel(n){
  stopCur(); cur.n=n; cur.mis=0; setHud(n); showScene(n); show('s-play');
  ({1:runL1,2:runL2,3:runL3,4:runL4,5:runL5})[n]();
}
const PASSMSG = {
  1:['左CLICK小達人！','你識得用左CLICK收集氣球喇，好叻呀！'],
  2:['雙CLICK小達人！','你雙CLICK都好準，同每個人打咗招呼！'],
  3:['右CLICK小達人！','你識得用右CLICK打開選單，好勁呀！'],
  4:['複製貼上小達人！','你整出一盒香噴噴嘅曲奇喇！'],
  5:['拖曳小達人！','書包執好喇，可以出發上課！']
};
const lvScore=()=>20-Math.min(8,(cur.mis||0)*2);
function passLevel(n,score){
  stopCur(); sfx.win();
  score = score==null ? lvScore() : score;
  const tot=recLevel(n,score);
  const [t,m]=PASSMSG[n];
  const stars = score>=18?'⭐⭐⭐':score>=15?'⭐⭐':'⭐';
  const pics=['boyjump','girljump','girljump2'];
  $('res').innerHTML = `${img(pics[n%3],'pic float')}<h2>🎉 ${t}</h2><p>${m}</p>
    <div class="sc">${stars}　本關得分：${score} / 20　累積：${tot} / 100</div>
    <div class="row"><button class="btn green" id="nextBtn">${n<5?'下一關 ▶':'拎證書 🏆'}</button></div>`;
  $('nextBtn').onclick=()=> n<5 ? openTut(n+1) : showCert();
  show('s-res');
}
function failLevel(n,title,msg){
  stopCur(); sfx.fail();
  $('res').innerHTML = `${img('bee1','pic float')}<h2>${title}</h2><p>${msg}</p>
    <div class="row"><button class="btn" id="retryBtn">再試一次 🔁</button></div>`;
  $('retryBtn').onclick=()=>startLevel(n);
  show('s-res');
}
$('muteBtn').onclick=()=>{ muted=!muted; $('muteBtn').textContent=muted?'🔇':'🔊'; };
$('homeBtn').onclick=()=>{ if(confirm('返回首頁？今次嘅進度會冇咗。')){ stopCur(); show('s-home'); } };

/* ====================== LEVEL 1 : left click balloons ====================== */
const BCOL=['#FF5D5D','#FFB02E','#FFD93B','#5CC96B','#4DB8F0','#B07CE8','#FF7EB6'];
function balloonSVG(c){
  return `<svg viewBox="0 0 60 96" width="70" height="112"><path d="M30 3C14 3 4 17 4 31c0 17 14 30 26 34C42 61 56 48 56 31 56 17 46 3 30 3z" fill="${c}" stroke="#2F3A45" stroke-width="3.5"/><path d="M24 63l6 9 6-9z" fill="${c}" stroke="#2F3A45" stroke-width="3.5" stroke-linejoin="round"/><path d="M30 72c-7 8 7 12 0 22" fill="none" stroke="#2F3A45" stroke-width="2.5"/><ellipse cx="19" cy="21" rx="6" ry="10" fill="#fff" opacity=".6" transform="rotate(25 19 21)"/></svg>`;
