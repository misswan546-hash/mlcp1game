    <button class="mini" id="muteBtn" title="聲音">🔊</button>
    <button class="mini" id="homeBtn" title="返回首頁">🏠</button>
  </div>

  <div id="sc1" class="scene">
    <svg class="sunray" viewBox="-100 -100 200 200"><g id="sunrays" class="spinrays"></g><circle r="46" fill="#FFD54A" stroke="#F2A900" stroke-width="5"/><circle cx="-16" cy="-8" r="6" fill="#2F3A45"/><circle cx="16" cy="-8" r="6" fill="#2F3A45"/><path d="M-18 12Q0 30 18 12" stroke="#2F3A45" stroke-width="5" fill="none" stroke-linecap="round"/></svg>
    <div class="cloud" style="top:14vh;width:14vw;height:5vh;animation-duration:60s"></div>
    <div class="cloud" style="top:28vh;width:10vw;height:4vh;animation-duration:85s;animation-delay:-30s"></div>
    <img class="school-bg" id="bg1">
    <div id="bl-layer"></div>
    <div id="count1"></div>
  </div>

  <div id="sc2" class="scene">
    <div class="ceil"></div>
    <div class="wallrow"><div class="win"></div><div class="board">通告板</div><div class="win"></div><div class="win"></div><div class="board">好學生</div><div class="win"></div></div>
    <div class="floorline"></div>
    <div id="walkers"></div>
  </div>

  <div id="sc3" class="scene">
    <div class="rays"></div>
    <div class="stage3">
      <div class="mascot" id="mascot3"></div>
